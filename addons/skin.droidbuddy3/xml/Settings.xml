<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>DroidInternalBackground</include>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>1740</width>
			<top>0</top>
			<bottom>0</bottom>
			<include>OpenClose_Right</include>
			<control type="image">
				<left>-30</left><top>105</top><width>1800</width><height>865</height>
				<texture border="36" colordiffuse="B8000B16">dialogs/dialog-bg-nobo.png</texture>
			</control>
			<control type="label">
				<left>0</left><top>118</top><width>1740</width><height>42</height>
				<label>QUICK ACCESS</label><font>font25_title</font><textcolor>DroidCyan</textcolor>
			</control>
			<control type="image">
				<left>235</left><top>140</top><width>1505</width><height>2</height>
				<texture colordiffuse="9900D9FF">colors/white.png</texture>
			</control>
			<control type="label">
				<left>0</left><top>428</top><width>1740</width><height>42</height>
				<label>SETTINGS</label><font>font25_title</font><textcolor>DroidCyan</textcolor>
			</control>
			<control type="image">
				<left>175</left><top>450</top><width>1565</width><height>2</height>
				<texture colordiffuse="9900D9FF">colors/white.png</texture>
			</control>
			<control type="panel" id="9000">
				<left>0</left>
				<width>100%</width>
				<top>165</top>
				<height>230</height>
				<onup>Control.SetFocus(9001,$INFO[Container(9000).Position],absolute)</onup>
				<onup>Down</onup>
				<ondown>Control.SetFocus(9001,$INFO[Container(9000).Position],absolute)</ondown>
				<include>SettingsPanel</include>
				<content>
					<item>
						<label>$LOCALIZE[10003]</label>
						<onclick>ActivateWindow(filemanager)</onclick>
						<icon>droidbuddy3/settings-icons/filemanager.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[24001]</label>
						<onclick>ActivateWindow(addonbrowser)</onclick>
						<icon>droidbuddy3/settings-icons/addons.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[138]</label>
						<onclick>ActivateWindow(systeminfo)</onclick>
						<icon>droidbuddy3/settings-icons/sysinfo.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[31067]</label>
						<onclick>ActivateWindow(eventlog)</onclick>
						<icon>droidbuddy3/settings-icons/eventlog.png</icon>
					</item>
				</content>
			</control>
			<control type="panel" id="9001">
				<left>0</left>
				<right>0</right>
				<top>475</top>
				<bottom>20</bottom>
				<onup>Control.SetFocus(9000,$INFO[Container(9001).Position],absolute)</onup>
				<ondown>Up</ondown>
				<ondown>Control.SetFocus(9000,$INFO[Container(9001).Position],absolute)</ondown>
				<include>SettingsPanel</include>
				<content>
					<item>
						<label>$LOCALIZE[14200]</label>
						<onclick>ActivateWindow(PlayerSettings)</onclick>
						<icon>droidbuddy3/settings-icons/player.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[14211]</label>
						<onclick>ActivateWindow(MediaSettings)</onclick>
						<icon>droidbuddy3/settings-icons/media.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[14204]</label>
						<onclick>ActivateWindow(PVRSettings)</onclick>
						<icon>droidbuddy3/settings-icons/livetv.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[14036]</label>
						<onclick>ActivateWindow(ServiceSettings)</onclick>
						<icon>droidbuddy3/settings-icons/network.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[15016]</label>
						<visible>System.GetBool(gamesgeneral.enable)</visible>
						<onclick>ActivateWindow(GameSettings)</onclick>
						<icon>droidbuddy3/settings-icons/games.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[14206]</label>
						<onclick>ActivateWindow(InterfaceSettings)</onclick>
						<icon>droidbuddy3/settings-icons/interface.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[13200]</label>
						<onclick>ActivateWindow(Profiles)</onclick>
						<icon>droidbuddy3/settings-icons/profiles.png</icon>
					</item>
					<item>
						<label>$LOCALIZE[13000]</label>
						<onclick>ActivateWindow(SystemSettings)</onclick>
						<icon>droidbuddy3/settings-icons/system.png</icon>
					</item>
					<item>
						<label>LibreELEC</label>
						<onclick>RunAddon(service.libreelec.settings)</onclick>
						<icon>droidbuddy3/settings-icons/libreelec.png</icon>
						<visible>System.AddonIsEnabled(service.libreelec.settings)</visible>
					</item>
				</content>
			</control>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="SYSTEM" />
		</include>
	</controls>
</window>
